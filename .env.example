# OPEN_APT_AGENT Environment Variables Template
# Copy to `.env` (gitignored) and fill in your local values. Never commit secrets.

# Path to YAML configuration file (e.g., config/local.yaml or config/default.example.yaml)
# APT_AGENT_CONFIG=config/local.yaml

# ---------------------------------------------------------------------------
# LLM Configuration (fill credentials before enabling LLM-backed mode)
# ---------------------------------------------------------------------------
# Canonical nested format: APT_AGENT_<SECTION>__<FIELD>
# Uncomment and fill these when configuring via APT_AGENT_LLM__* (commented out
# by default so sourcing .env does not override OPENAI_API_KEY/BASE_URL/MODEL).
APT_AGENT_LLM__ENABLED=false
APT_AGENT_LLM__PROVIDER=openai_compatible
# APT_AGENT_LLM__BASE_URL=https://api.openai.com/v1
# APT_AGENT_LLM__API_KEY=
# APT_AGENT_LLM__MODEL=gpt-4o-mini

# Standard OpenAI-compatible environment fallbacks (lower priority than APT_AGENT_*)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Supported flat aliases for LLM / RAG / Snapshots:
# APT_AGENT_LLM_ENABLED=false
# APT_AGENT_LLM_PROVIDER=openai_compatible
# APT_AGENT_LLM_API_KEY=
# APT_AGENT_LLM_BASE_URL=https://api.openai.com/v1
# APT_AGENT_LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# RAG Configuration
# ---------------------------------------------------------------------------
APT_AGENT_RAG__KNOWLEDGE_PATH=packages/apt-rag/public_kb/chunks.jsonl.gz
APT_AGENT_RAG__MODE=bm25
APT_AGENT_RAG__OFFLINE=true
# Flat aliases:
# APT_AGENT_RAG_MODE=bm25
# APT_AGENT_RAG_KNOWLEDGE_PATH=packages/apt-rag/public_kb/chunks.jsonl.gz

# ---------------------------------------------------------------------------
# Snapshots Storage
# ---------------------------------------------------------------------------
APT_AGENT_SNAPSHOTS__ROOT_DIR=.apt_agent/snapshots
# Flat aliases:
# APT_AGENT_SNAPSHOTS_ROOT_DIR=.apt_agent/snapshots
# APT_AGENT_SNAPSHOTS_ROOT=.apt_agent/snapshots

# ---------------------------------------------------------------------------
# Detection Engine & Ruleset Overrides (canonical nested format)
# ---------------------------------------------------------------------------
# APT_AGENT_ENGINES__ZIRCOLITE__BIN_PATH=/path/to/tools/Zircolite/Zircolite
# APT_AGENT_ENGINES__ZIRCOLITE__RULES_DIR=/path/to/sigma/rules
# APT_AGENT_ENGINES__ZIRCOLITE__CONFIG_PATH=script/log_convert/configs/zircolite_config.yaml

# APT_AGENT_ENGINES__HAYABUSA__BIN_PATH=/path/to/tools/hayabusa/hayabusa
# APT_AGENT_ENGINES__HAYABUSA__RULES_DIR=/path/to/tools/hayabusa/rules
# APT_AGENT_ENGINES__HAYABUSA__CONFIG_PATH=/path/to/tools/hayabusa/config

# APT_AGENT_ENGINES__TAKAJO__BIN_PATH=/path/to/tools/takajo/takajo
# APT_AGENT_ENGINES__TAKAJO__WORKING_DIR=/path/to/tools/takajo

# APT_AGENT_ENGINES__CHAINSAW__BIN_PATH=/path/to/tools/chainsaw/chainsaw
# APT_AGENT_ENGINES__CHAINSAW__RULES_DIR=/path/to/sigma/rules
# APT_AGENT_ENGINES__CHAINSAW__MAPPING_PATH=/path/to/tools/chainsaw/mappings/sigma-event-logs-json.yml
# APT_AGENT_ENGINES__CHAINSAW__CONFIG_PATH=script/log_convert/configs/chainsaw_custom_mapping.yml

# APT_AGENT_ENGINES__RSIGMA__BIN_PATH=/path/to/tools/rsigma/rsigma
# APT_AGENT_ENGINES__RSIGMA__RULES_DIR=/path/to/sigma/rules
# APT_AGENT_ENGINES__RSIGMA__CONFIG_PATH=script/log_convert/configs/rsigma_pipeline.yml
